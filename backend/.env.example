# Copiar a .env y completar. El archivo .env NO se versiona.

# Módulo de configuración. En local no hace falta definirlo: manage.py ya usa
# config.settings.local. En Render se define como config.settings.production.
# DJANGO_SETTINGS_MODULE=config.settings.local

# Proveedor de IA activo: fake | gemini | anthropic | deepseek | openrouter
# Varios separados por coma forman una cadena de respaldo: se usa el primero y,
# si falla o agota su cuota, el siguiente. Ej.: IA_PROVEEDOR=gemini,deepseek
# DeepSeek y OpenRouter NO son aptos para datos personales: la revisión de CV
# con IA los salta aunque estén en la cadena.
IA_PROVEEDOR=fake

# Gemini (capa gratuita, sin tarjeta): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional. Por defecto gemini-3.5-flash-lite
GEMINI_MODEL=

# Anthropic (de pago): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Opcional. Por defecto claude-haiku-4-5-20251001
ANTHROPIC_MODEL=

# DeepSeek, API oficial: https://platform.deepseek.com
# Créditos gratis por ~30 días al crear la cuenta; después es de pago.
DEEPSEEK_API_KEY=
# Opcional. Por defecto deepseek-chat
DEEPSEEK_MODEL=

# OpenRouter: https://openrouter.ai/keys (la clave empieza con sk-or-).
# Da acceso a modelos de varios fabricantes; los gratuitos llevan ":free" en el
# nombre (~50 peticiones/día). Obligatorio nombrar el modelo: no hay uno por
# defecto porque el catálogo gratuito cambia. Ver https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Solo para la prueba de carga (tests/carga/README.md): milisegundos que el
# proveedor falso tarda en cada llamada, para imitar la IA real. Vacío = 0.
IA_FAKE_LATENCIA_MS=

# PostgreSQL (Neon en producción; vacío usa SQLite en local).
# Obligatorio en producción: sin esto el servidor no arranca.
DATABASE_URL=

# Django. En producción SECRET_KEY y ALLOWED_HOSTS son obligatorios y el
# proceso aborta si faltan — nunca hay valor por defecto inseguro.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend permitido para peticiones CORS (Vite en desarrollo; el dominio de
# Vercel en producción). Separar con comas si hay más de uno.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login con Google: Google Cloud Console -> APIs y servicios -> Credenciales
# -> ID de cliente de OAuth (tipo "Aplicación web").
GOOGLE_OAUTH_CLIENT_ID=
